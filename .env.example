# Application
PORT=3000
NODE_ENV=dev
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3001
ENABLE_SWAGGER=true
SWAGGER_USERNAME=taliko
SWAGGER_PASSWORD=taliko

# Database (PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taliko
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNC=true
DB_SSL=false
DB_LOGGING=false

# Authentication
JWT_SECRET=super-secret-taliko-jwt-key
JWT_EXPIRATION_TIME=1d
JWT_REFRESH_SECRET=super-secret-taliko-refresh-key
JWT_REFRESH_EXPIRATION_TIME=7d

# Redis (Cache & Quotas)
REDIS_URL=
REDIS_DEFAULT_TTL=3600

# Mailer (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@taliko.app

# Cloud Storage & Media (Cloudinary / CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_BASE_URL=https://cdn.taliko.app
